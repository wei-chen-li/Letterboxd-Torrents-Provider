{
    "manifest_version": 2,
    "name": "Letterboxd Torrents Provider",
    "description": "Letterboxd extension that provides you torrents for movies.",
    "version": "1.5.0",
    "icons": {
        "128": "icon128.png"
    },
    "permissions": [
		"https://letterboxd.com/*",
        "storage"
    ],
    "browser_action": {
        "default_popup": "src/options.html"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [ "https://letterboxd.com/film/*" ],
            "js": [
                "src/default-sites.js",
                "src/letterboxd-torrents-provider.js"
            ],
            "run_at": "document_end"
        }
    ],
  "applications": {
    "gecko": {
      "id": "letterboxd-torrents-provider@example.com"
    }
  }
}